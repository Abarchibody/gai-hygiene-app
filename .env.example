# Configuration Supabase pour la synchronisation cloud
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Instructions:
# 1. Créer un compte sur https://supabase.com
# 2. Créer un nouveau projet
# 3. Copier l'URL et la clé anonyme depuis Settings > API
# 4. Renommer ce fichier en .env et remplir les valeurs
# 5. Créer les tables dans Supabase avec le SQL fourni dans /docs/supabase-schema.sql